#!/usr/bin/env bash
#
# s - ssh to a host, expanding short/.local hostnames and a default user
#
# Usage: s [ssh-options...] [-r] [user@]hostname [command...]
#
# Drop-in replacement for ssh: any ssh option may appear before the
# destination, exactly like real ssh (options after the destination are
# the remote command, per ssh's own grammar). Our one addition, -r, may
# appear anywhere among the leading options.
#
#   -r        connect as root instead of the default user (REMOTE_DEFAULT_USER,
#             "jkh" if unset)
#
# A hostname with no dot is expanded to "hostname.local". An explicit
# "user@" prefix overrides the default user (and -r). Set SSH_CMD to use
# a different client (mosh, etc); see also sm. Set REMOTE_OPT_TAKES_ARG
# to override which short options consume a separate argument, when the
# client's grammar differs from ssh's (see sm).
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=remote-common.sh
source "${SCRIPT_DIR}/remote-common.sh"

usage() {
	echo "Usage: s [ssh-options...] [-r] [user@]hostname [command...]" >&2
	exit 1
}

[[ $# -ge 1 ]] || usage

# Short options that consume a separate argument (unless the value is
# bundled, e.g. -p2222), matching ssh(1)'s own option grammar by default.
# Override with REMOTE_OPT_TAKES_ARG when the client's grammar differs.
takes_arg="${REMOTE_OPT_TAKES_ARG:-BbcDEeFIiJLlmOopQRSWw}"

ssh_opts=()
root_flag=()
host=""
i=0
args=("$@")
n=$#

while (( i < n )); do
	arg="${args[$i]}"

	if [[ -n "$host" ]]; then
		break
	fi

	if [[ "$arg" == "--" ]]; then
		(( ++i ))
		[[ $i -lt $n ]] || usage
		host="${args[$i]}"
		(( ++i ))
		break
	fi

	if [[ "$arg" == "-r" ]]; then
		root_flag=(-r)
		(( ++i ))
		continue
	fi

	if [[ "$arg" == -?* ]]; then
		ssh_opts+=("$arg")
		if [[ "${#arg}" -eq 2 && "$takes_arg" == *"${arg:1:1}"* ]]; then
			(( ++i ))
			if [[ $i -lt $n ]]; then
				ssh_opts+=("${args[$i]}")
			fi
		fi
		(( ++i ))
		continue
	fi

	host="$arg"
	(( ++i ))
done

[[ -n "$host" ]] || usage

remaining=("${args[@]:$i}")

target="$(remote_resolve_host "${root_flag[@]}" "$host")"
exec "${SSH_CMD:-ssh}" "${ssh_opts[@]}" "$target" "${remaining[@]+"${remaining[@]}"}"
