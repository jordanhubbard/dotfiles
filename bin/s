#!/usr/bin/env bash
#
# s - ssh to a host, expanding short/.local hostnames and a default user
#
# Usage: s [user@]hostname [-r] [ssh-args...]
#   -r        connect as root instead of the default user (REMOTE_DEFAULT_USER,
#             "jkh" if unset)
#
# A hostname with no dot is expanded to "hostname.local". An explicit
# "user@" prefix overrides the default user (and -r). Set SSH_CMD to use
# a different client (mosh, etc); see also sm.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=remote-common.sh
source "${SCRIPT_DIR}/remote-common.sh"

if [[ $# -lt 1 ]]; then
	echo "Usage: s hostname [-r] [ssh-args...]" >&2
	exit 1
fi

host="$1"
shift

root_flag=()
if [[ "${1:-}" == "-r" ]]; then
	root_flag=(-r)
	shift
fi

target="$(remote_resolve_host "${root_flag[@]}" "$host")"
exec "${SSH_CMD:-ssh}" "$target" "$@"
