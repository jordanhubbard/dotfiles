#!/usr/bin/env bash
#
# sm - mosh to a host, using the same hostname/user resolution as s
#
# Usage: sm [mosh-options...] [-r] [user@]hostname [command...]
#
# Forwards straight through to s's option parser, but with mosh's own
# short-option grammar instead of ssh's: of mosh's single-letter flags
# (-p, -4, -6, -a, -o, -v), only -p takes a separate argument (a UDP
# port). ssh's -o takes an argument; mosh's -o (--predict-overwrite)
# does not, so this distinction matters - without it, "sm -o myhost"
# would swallow the hostname as -o's value.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec env SSH_CMD=mosh REMOTE_OPT_TAKES_ARG=p "${SCRIPT_DIR}/s" "$@"
